import("//tools/grit/grit_rule.gni")
import("//ui/webui/resources/tools/generate_grd.gni")

generate_grd("build_grd") {
  grd_prefix = "dockium_welcome"
  out_grd = "$target_gen_dir/${grd_prefix}_resources.grd"
  input_files_base_dir = rebase_path(".", "//")
  input_files = [
    "index.html",
    "welcome.css",
    "welcome.js",
    "slide1.png",
    "slide2.png",
    "slide3.png",
    "slide4.png",
    "slide5.png",
    "slide6.png",
    "slide7.png",
    "intro.mp3",
    "logo.png",
  ]
}

grit("resources") {
  enable_input_discovery_for_gn_analyze = false
  source = "$target_gen_dir/dockium_welcome_resources.grd"
  deps = [ ":build_grd" ]
  outputs = [
    "grit/dockium_welcome_resources.h",
    "grit/dockium_welcome_resources_map.cc",
    "grit/dockium_welcome_resources_map.h",
    "dockium_welcome_resources.pak",
  ]
  output_dir = "$root_gen_dir/chrome"
}
